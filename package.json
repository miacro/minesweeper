{
  "name": "minesweeper",
  "version": "1.0.0",
  "description": "A multilingual React Minesweeper game",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "npm run test:unit && npm run test:browser",
    "test:unit": "node --test tests/*.test.mjs",
    "test:browser": "playwright test --project=chromium",
